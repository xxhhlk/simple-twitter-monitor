# Required: create a key at https://twitterapi.io/dashboard
TWITTERAPI_IO_KEY=replace_with_your_key

# Monitoring
TARGET_ACCOUNT=WorkBuddy_AI
POLL_SECONDS=600
INITIAL_HOURS=24
DB_PATH=monitor.db
REQUEST_TIMEOUT=30
EXCLUDE_REPLIES=true

# Notification: generic, dingtalk, or wecom
WEBHOOK_TYPE=dingtalk
WEBHOOK_URL=
# Required only for a DingTalk signed robot
DINGTALK_SECRET=

# Safe first run: logs matches but sends no webhook
DRY_RUN=true
LOG_LEVEL=INFO
