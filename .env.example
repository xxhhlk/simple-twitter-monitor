# Required: auth_token cookie from the X account used for monitoring.
# Treat this like a password. Never commit a real value.
SCWEET_AUTH_TOKEN=replace_with_your_auth_token
# Optional: set the ct0 cookie from the same browser session to skip X homepage bootstrap.
# Store it as a GitHub Actions Secret if the hosted runner's bootstrap request gets HTTP 403.
SCWEET_CT0=

# Monitoring
TARGET_ACCOUNT=WorkBuddy_AI
POLL_SECONDS=600
INITIAL_HOURS=72
MAX_TWEETS_PER_FETCH=100
DB_PATH=monitor.db
SCWEET_DB_PATH=scweet_state.db
REQUEST_TIMEOUT=30
EXCLUDE_REPLIES=true

# Notification: generic, dingtalk, or wecom
WEBHOOK_TYPE=dingtalk
WEBHOOK_URL=
# Required only for a DingTalk signed robot
DINGTALK_SECRET=

# Safe first run: logs matches but sends no webhook
DRY_RUN=true
LOG_LEVEL=INFO
