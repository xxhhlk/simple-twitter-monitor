# Copy to /etc/workbuddy-monitor.env and replace the placeholders.
# Keep this file root-owned with mode 0600; never commit real credentials.
SCWEET_AUTH_TOKEN=replace_with_your_auth_token
# Optional: ct0 from the same X browser session, if auth bootstrap returns HTTP 403.
SCWEET_CT0=

TARGET_ACCOUNT=WorkBuddy_AI
INITIAL_HOURS=72
MAX_TWEETS_PER_FETCH=100
EXCLUDE_REPLIES=true

WEBHOOK_TYPE=dingtalk
WEBHOOK_URL=replace_with_your_dingtalk_webhook
DINGTALK_SECRET=replace_with_your_dingtalk_signing_secret

# Start safely; switch to false after verifying one manual run.
DRY_RUN=true
